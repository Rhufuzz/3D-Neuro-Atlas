generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

model User {
  id            String              @id @default(cuid())
  name          String?
  email         String              @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String              @default("student")
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  accounts      Account[]
  sessions      Session[]
  flashcards    FlashcardProgress[]
  quizAttempts  QuizAttempt[]
  modules       ModuleProgress[]
  learnSteps    LearnStepProgress[]
  goalTicks     GoalProgress[]
  customCards   UserFlashcard[]
  sampleExams   SampleExamAttempt[]
  elaborations  GoalElaboration[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// SM-2 spaced repetition state, one row per user x card
model FlashcardProgress {
  id           String   @id @default(cuid())
  userId       String
  cardId       String
  easeFactor   Float    @default(2.5)
  interval     Int      @default(0)
  repetitions  Int      @default(0)
  lapses       Int      @default(0)
  reviews      Int      @default(0)
  dueAt        DateTime @default(now())
  lastReviewed DateTime?
  lastGrade    Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, cardId])
  @@index([userId, dueAt])
}

model QuizAttempt {
  id         String   @id @default(cuid())
  userId     String
  mode       String
  scope      String
  score      Int
  total      Int
  durationS  Int      @default(0)
  answers    Json
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model ModuleProgress {
  id         String   @id @default(cuid())
  userId     String
  moduleId   String
  completed  Boolean  @default(false)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId])
}

// Guided-path steps ticked per module ("Mark as understood"), one row per user x module x step
model LearnStepProgress {
  id        String   @id @default(cuid())
  userId    String
  moduleId  String
  stepIndex Int
  done      Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId, stepIndex])
  @@index([userId])
}

// Official learning goals ticked off per module, one row per user x module x goal
model GoalProgress {
  id        String   @id @default(cuid())
  userId    String
  moduleId  String
  goalIndex Int
  done      Boolean  @default(false)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId, goalIndex])
  @@index([userId])
}

// User-created cards (e.g. "add this exam question I missed to my deck"), with
// their own SM-2 state — separate from the curated FLASHCARDS registry.
model UserFlashcard {
  id          String   @id @default(cuid())
  userId      String
  front       String   @db.Text
  back        String   @db.Text
  sourceKind  String   @default("manual")
  sourceRef   String?
  easeFactor  Float    @default(2.5)
  interval    Int      @default(0)
  repetitions Int      @default(0)
  lapses      Int      @default(0)
  reviews     Int      @default(0)
  dueAt       DateTime @default(now())
  lastGrade   Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dueAt])
}

// Attempts of the official 65-question sample exam (scored server-side from the key).
model SampleExamAttempt {
  id        String   @id @default(cuid())
  userId    String
  part      String
  score     Int
  total     Int
  answers   Json
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// Student self-explanations per learning goal ("explain it in your own words"),
// with confidence self-rating: clear, shaky, or lost.
model GoalElaboration {
  id         String   @id @default(cuid())
  userId     String
  moduleId   String
  goalIndex  Int
  text       String   @db.Text
  confidence String   @default("shaky")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, moduleId, goalIndex])
  @@index([userId])
}
