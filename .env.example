# Copy to .env and fill in. Never commit the real .env.
# deploy/setup-env.sh can generate this file (with random secrets) on the VPS.

# PostgreSQL connection string
DATABASE_URL="postgresql://cortex_aether:CHANGE_ME@127.0.0.1:5432/cortex_aether"

# Auth.js (next-auth v5) secrets: generate with `openssl rand -base64 32` (same value is fine for both)
AUTH_SECRET="CHANGE_ME"
NEXTAUTH_SECRET="CHANGE_ME"

# Public base URL the browser uses (scheme + host + port)
NEXTAUTH_URL="https://YOUR_HOST:8445"
AUTH_TRUST_HOST=true

# Optional: `npm run seed` creates/promotes this admin account (skipped when empty)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
