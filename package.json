{
  "name": "cortex-aether",
  "version": "0.1.0",
  "private": true,
  "description": "CORTEX-AETHER: interactive 3D neuro-atlas and study engine for Biological & Cognitive Psychology",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "seed": "tsx --require dotenv/config scripts/seed.ts",
    "smoke": "node scripts/auth-smoke.mjs",
    "postinstall": "prisma generate",
    "test": "node --import tsx --test 'tests/*.test.ts'",
    "checkdois": "tsx scripts/check-dois.ts"
  },
  "prisma": {
    "seed": "tsx --require dotenv/config scripts/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "2.11.3",
    "@prisma/client": "6.7.0",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "dotenv": "16.5.0",
    "lucide-react": "0.446.0",
    "next": "16.4.1",
    "next-auth": "5.0.0-beta.32",
    "next-themes": "0.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "1.5.0",
    "tailwind-merge": "2.5.2",
    "three": "0.170.0",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.170.0",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.47",
    "prisma": "6.7.0",
    "tailwindcss": "3.4.0",
    "tailwindcss-animate": "1.0.7",
    "tsx": "4.20.3",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
